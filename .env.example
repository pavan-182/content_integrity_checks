# Optional GPT-OSS gateway. Leave these empty for an unconfigured deployment.
# Use --offline for a deterministic run without gateway configuration or network.
INTELLIHUB_API_KEY=
INTELLIHUB_BASE_URL=https://gateway.example.invalid/v1
INTELLIHUB_MODEL=deployment/model-name
# Optional display identity; defaults to the final component of INTELLIHUB_MODEL.
INTELLIHUB_MODEL_ID=
INTELLIHUB_VERIFY_SSL=true
# Optional absolute path to an organization-provided CA certificate bundle.
INTELLIHUB_CA_BUNDLE=
# Set INTELLIHUB_ENV_FILE in the shell to select a file other than .env.
# Frontend server settings are shell variables, not read from this file:
# ASCO_PIPELINE_INPUT=/absolute/path/to/approved/xmls
# PORT=8000
