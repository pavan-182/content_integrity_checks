<article dtd-version="1.3" article-type="meeting-abstract" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xlink="http://www.w3.org/1999/xlink"><front><journal-meta><journal-id journal-id-type="hwp">ascomtg</journal-id><journal-id journal-id-type="pmc">ascomtg</journal-id><journal-id journal-id-type="publisher-id">ASCOMTG</journal-id><journal-title-group><journal-title>Journal of Clinical Oncology</journal-title><abbrev-journal-title>ASCO MEETING ABSTRACTS</abbrev-journal-title></journal-title-group><issn pub-type="ppub">0732-183X</issn><issn pub-type="epub">1527-7755</issn><publisher><publisher-name>American Society of Clinical Oncology</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="custom" custom-type="meeting-id">335</article-id><article-id pub-id-type="custom" custom-type="session-id">17304</article-id><article-id pub-id-type="custom" custom-type="session-participation-id">8008200</article-id><article-id pub-id-type="custom" custom-type="temporary-abstract-id">43223</article-id><article-id pub-id-type="custom" custom-type="abstract-id">rw43223</article-id><article-id pub-id-type="doi">10.18632/oncotarget.21431</article-id><article-categories><subj-group subj-group-type="heading"><subject>Biology - Cancer</subject></subj-group><series-title>2026 ASCO Annual Meeting (May 29 - June 2, 2026)</series-title><series-text>Publication Only</series-text></article-categories><title-group><article-title>Methylation-induced downregulation and tumor suppressive role of microRNA-29b in gastric cancer through targeting LASP1</article-title></title-group><contrib-group><contrib id="C8008200" contrib-type="presenter"><name><surname>Li</surname><given-names>Hui</given-names></name><xref ref-type="aff" rid="A8008200" /></contrib><contrib id="C8008201" contrib-type="author"><name><surname>Liu</surname><given-names>Guiqing</given-names></name><xref ref-type="aff" rid="A8008200" /></contrib><contrib id="C8008202" contrib-type="author"><name><surname>Pan</surname><given-names>Ke</given-names></name><xref ref-type="aff" rid="A8008200" /></contrib><contrib id="C8008203" contrib-type="author"><name><surname>Miao</surname><given-names>Xiongying</given-names></name><xref ref-type="aff" rid="A8008200" /></contrib><contrib id="C8008204" contrib-type="author"><name><surname>Xie</surname><given-names>Yong</given-names></name><xref ref-type="aff" rid="A8008200" /></contrib><aff id="A8008200">Department of Anesthesia, Second Xiangya Hospital, Central South University, Changsha, Hunan, China; Department of General Surgery, Second Xiangya Hospital, Central South University, Changsha, Hunan, China;</aff></contrib-group><pub-date pub-type="ppub"><year>2017</year></pub-date><fpage>rw43223</fpage><lpage>rw43223</lpage><permissions><copyright-statement>ASCO-style conversion for internal testing; source rights remain with the original publisher.</copyright-statement><copyright-year>2017</copyright-year></permissions><abstract><p><bold>rw43223</bold></p><p>MicroRNAs (miRs) have been demonstrated to play promoting or tumor suppressive roles in various human cancers, but the regulatory mechanism of miR-29b underlying gastric cancer development and progression still remains largely unclear. In the present study, we found that miR-29b was significantly downregulated in gastric cancer tissues and cell lines. Low expression of miR-29b was significantly associated with DNA methylation, and treatment with DNA methyltransferase inhibitor 5-Aza-20-deoxycytidine upregulated miR-29b in gastric cancer cells. In addition, both reduced miR-29b expression and miR-29b methylation were associated with disease progression and poor prognosis in gastric cancer. Restoration of miR-29b caused a reduction in gastric cancer cell proliferation, migration, and invasion, and inhibited tumor growth</p></abstract><custom-meta-group><custom-meta><meta-name>source-row-number</meta-name><meta-value>82</meta-value></custom-meta><custom-meta><meta-name>source-record-id</meta-name><meta-value>43223.0</meta-value></custom-meta><custom-meta><meta-name>source-journal</meta-name><meta-value>Oncotarget</meta-value></custom-meta><custom-meta><meta-name>source-publisher</meta-name><meta-value>Impact Journals</meta-value></custom-meta><custom-meta><meta-name>source-country</meta-name><meta-value>China</meta-value></custom-meta><custom-meta><meta-name>source-article-type</meta-name><meta-value>Research Article;</meta-value></custom-meta><custom-meta><meta-name>manual-verdict</meta-name><meta-value>YES</meta-value></custom-meta><custom-meta><meta-name>source-reason</meta-name><meta-value>Concerns/Issues about Data;Duplication of/in Image;Investigation by Third Party;Paper Mill;</meta-value></custom-meta></custom-meta-group></article-meta></front></article>
